{
  "name": "daou-gw-cli",
  "version": "0.3.0",
  "description": "Unofficial CLI and MCP server for Daou Office groupware",
  "license": "UNLICENSED",
  "keywords": [
    "daou-office",
    "groupware",
    "cli",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "SKILL.md",
    "docs"
  ],
  "type": "module",
  "bin": {
    "daou-gw-cli": "dist/index.js",
    "daou-gw-mcp": "dist/mcp.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "build": "tsup && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "tough-cookie": "^5.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
